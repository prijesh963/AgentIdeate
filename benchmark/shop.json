      "question": "Which services exist and what do they expose?",
      "tool": "repo_overview",
      "args": {},
      "expect": [
        "Service order-service [gradle]",
        "Service inventory-service [maven]",
        "Service shipping-service",
        "GET    /api/prices/{sku}",
        "calls out: PricingClient -> pricing-service"
      ],
      "files": [
        "order-service/src/main/java/com/shop/order/OrderServiceApplication.java",
        "inventory-service/src/main/java/com/shop/inventory/InventoryApplication.java",
        "pricing-service/src/main/java/com/shop/pricing/PricingApplication.java",
        "shipping-service/src/main/java/com/shop/shipping/ShippingApplication.java",

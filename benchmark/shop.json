        "shipping-service/build.gradle"
      ]
    },
    {
      "id": "flow-place-order",
      "question": "How does POST /api/orders work end to end?",
      "tool": "endpoint_flow",
      "args": {
        "path": "/api/orders",
        "method": "POST"
      },
      "expect": [
        "OrderService.placeOrder -> OrderServiceImpl#placeOrder",
        "PricingClient#getPrice [feign -> pricing-service",
        "PriceService#currentPrice",
        "-> kafka order.created",
        "=> consumed in inventory-service",
        "=> consumed in shipping-service"
      ],
      "files": [
        "order-service/src/main/java/com/shop/order/web/OrderController.java",
        "order-service/src/main/java/com/shop/order/config/ApiPaths.java",
        "order-service/src/main/java/com/shop/order/service/OrderService.java",
        "order-service/src/main/java/com/shop/order/service/OrderServiceImpl.java",
        "order-service/src/main/java/com/shop/order/client/PricingClient.java",
        "pricing-service/src/main/java/com/shop/pricing/web/PriceController.java",
        "pricing-service/src/main/java/com/shop/pricing/service/PriceService.java",
